    {
      "parameters": {
        "jsCode": "// Получаем данные после Summarize\nconst data = $input.first().json;\n\n// Получаем запрос пользователя\nconst userMessage = $('Сообщение от пользователя').item.json.message.text || \"Запрос не найден\";\n\n// Логируем, чтобы увидеть, какие поля пришли\nconsole.log('Поля после Summarize:', Object.keys(data));\nconsole.log('Данные:', JSON.stringify(data, null, 2));\n\n// Формируем список товаров\nconst productNames = data['concatenated_Наименование_товара'] || 'Товары не найдены';\nconst productPrices = data['concatenated_Стоимость'] || '';\n\n// Разделяем строки\nconst namesArray = productNames.split(': ').filter(name => name.trim() !== '');\nconst pricesArray = productPrices.split('\\n').filter(price => price.trim() !== '');\n\n// Собираем товары в один список\nlet productList = 'Список товаров и цены:\\n';\nnamesArray.forEach((name, index) => {\n    const price = pricesArray[index] || 'цена не указана';\n    productList += `${name} - ${price}\\n`;\n});\n\n// Формируем ПРАВИЛЬНЫЙ payload для LM Studio\nconst payload = {\n    model: \"qwen-2.5-7b-instruct-k-m\",\n    messages: [\n        {\n            role: \"system\",\n            content: \"Ты - ассистент по ценам. Отвечай вежливо и информативно. Указывай название товара и его стоимость. Если товар не найден, предложи похожие варианты.\"\n        },\n        {\n            role: \"user\",\n            content: `Запрос пользователя: ${userMessage}\\n\\n${productList}\\n\\nНайди стоимость запрашиваемого товара и дай ответ.`\n        }\n    ],\n    temperature: 0.3,\n    max_tokens: 300,\n    stream: false\n};\n\nconsole.log('Отправляемый payload:', JSON.stringify(payload, null, 2));\n\n// ВАЖНО: возвращаем ОДИН объект с полем json\nreturn [{ json: payload }];"
      },
